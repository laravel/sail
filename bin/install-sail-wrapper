#!/usr/bin/env bash

# Install sail-wrapper to a location in PATH
# This script is run automatically when the package is installed/updated

set -euo pipefail

# Colors for output
if [ -t 1 ]; then
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    NC='\033[0m' # No Color
else
    GREEN=''
    YELLOW=''
    NC=''
fi

# Find the wrapper script location (in vendor/bin after installation)
WRAPPER_SOURCE=""

# Try multiple locations to find the wrapper
if [ -f "$(dirname "$0")/sail-wrapper" ]; then
    WRAPPER_SOURCE="$(cd "$(dirname "$0")" && pwd)/sail-wrapper"
elif [ -f "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/sail-wrapper" ]; then
    WRAPPER_SOURCE="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)/sail-wrapper"
fi

# If not found, try relative to current working directory (when run from composer)
if [ -z "$WRAPPER_SOURCE" ] || [ ! -f "$WRAPPER_SOURCE" ]; then
    # Try to find it relative to composer vendor directory
    if [ -n "${COMPOSER_VENDOR_DIR:-}" ] && [ -f "$COMPOSER_VENDOR_DIR/reyemtech/sail/bin/sail-wrapper" ]; then
        WRAPPER_SOURCE="$COMPOSER_VENDOR_DIR/reyemtech/sail/bin/sail-wrapper"
    elif [ -f "vendor/reyemtech/sail/bin/sail-wrapper" ]; then
        WRAPPER_SOURCE="$(pwd)/vendor/reyemtech/sail/bin/sail-wrapper"
    fi
fi

if [ -z "$WRAPPER_SOURCE" ] || [ ! -f "$WRAPPER_SOURCE" ]; then
    echo "${YELLOW}Warning: Could not locate sail-wrapper script. Skipping installation.${NC}" >&2
    exit 0
fi

# Determine installation directory
INSTALL_DIR=""
for dir in "$HOME/.local/bin" "$HOME/bin" "/usr/local/bin"; do
    if [ -d "$dir" ] && [ -w "$dir" ]; then
        INSTALL_DIR="$dir"
        break
    fi
done

# If no writable directory found, try to create ~/.local/bin
if [ -z "$INSTALL_DIR" ]; then
    if mkdir -p "$HOME/.local/bin" 2>/dev/null; then
        INSTALL_DIR="$HOME/.local/bin"
    fi
fi

if [ -z "$INSTALL_DIR" ]; then
    echo "${YELLOW}Warning: Could not find a writable directory in PATH. Skipping sail-wrapper installation.${NC}" >&2
    echo "You can manually install it by copying bin/sail-wrapper to a directory in your PATH." >&2
    exit 0
fi

# Check if it's already in PATH
if ! echo "$PATH" | grep -q "$INSTALL_DIR"; then
    echo "${YELLOW}Note: $INSTALL_DIR is not in your PATH.${NC}" >&2
    echo "Add it to your shell profile (e.g., ~/.bashrc, ~/.zshrc):" >&2
    echo "  export PATH=\"\$HOME/.local/bin:\$PATH\"" >&2
    echo ""
fi

# Install the wrapper
INSTALL_TARGET="$INSTALL_DIR/sail"
INSTALLED=0

if [ -L "$INSTALL_TARGET" ] || [ -f "$INSTALL_TARGET" ]; then
    # Check if it's already our wrapper
    if [ -L "$INSTALL_TARGET" ] && [ "$(readlink -f "$INSTALL_TARGET")" = "$(readlink -f "$WRAPPER_SOURCE")" ]; then
        INSTALLED=1
    elif [ -f "$INSTALL_TARGET" ] && diff -q "$INSTALL_TARGET" "$WRAPPER_SOURCE" >/dev/null 2>&1; then
        INSTALLED=1
    else
        # Backup existing sail
        if [ -f "$INSTALL_TARGET" ]; then
            mv "$INSTALL_TARGET" "$INSTALL_TARGET.backup.$(date +%s)"
            echo "${YELLOW}Backed up existing sail to ${INSTALL_TARGET}.backup.*${NC}" >&2
        fi
    fi
fi

if [ $INSTALLED -eq 0 ]; then
    cp "$WRAPPER_SOURCE" "$INSTALL_TARGET"
    chmod +x "$INSTALL_TARGET"
    echo "${GREEN}✓ Installed sail-wrapper to $INSTALL_TARGET${NC}" >&2
    echo "  You can now use 'sail' from any directory to run the nearest project's Sail." >&2
else
    echo "${GREEN}✓ sail-wrapper is already installed at $INSTALL_TARGET${NC}" >&2
fi
