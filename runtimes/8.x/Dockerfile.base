ARG ALPINE_VERSION=3.21
FROM alpine:${ALPINE_VERSION}

WORKDIR /var/www/

ENV TZ=UTC

ARG PHP_VERSION=8.4
ARG PHP_VERSION_NUM=84
ARG GUID=1000

ENV VERSION=${PHP_VERSION_NUM}

# Copy mkcert root CA certificate
COPY --from=runtime certs/mkcert-rootCA.pem /usr/local/share/ca-certificates/mkcert-rootCA.crt

# Install runtime system dependencies (Alpine packages)
RUN apk add --no-cache \
    tzdata \
    gnupg \
    bash \
    curl \
    libpng \
    libjpeg-turbo \
    libwebp \
    libzip \
    oniguruma \
    icu \
    zlib \
    libxml2 \
    git \
    zip \
    xz \
    unzip \
    nginx \
    s6-overlay \
    su-exec \
    npm \
    libcap-setcap \
    php${VERSION} \
    php${VERSION}-fpm \
    php${VERSION}-gd \
    php${VERSION}-intl \
    php${VERSION}-mbstring \
    php${VERSION}-mysqlnd \
    php${VERSION}-opcache \
    php${VERSION}-pcntl \
    php${VERSION}-pdo \
    php${VERSION}-pdo_mysql \
    php${VERSION}-pdo_pgsql \
    php${VERSION}-pgsql \
    php${VERSION}-xml \
    php${VERSION}-zip \
    php${VERSION}-curl \
    php${VERSION}-exif \
    php${VERSION}-fileinfo \
    php${VERSION}-sqlite3 \
    php${VERSION}-xdebug\
    php${VERSION}-bcmath \
    php${VERSION}-dom \
    php${VERSION}-fileinfo \
    php${VERSION}-json \
    php${VERSION}-session \
    php${VERSION}-sodium \
    php${VERSION}-simplexml \
    php${VERSION}-tokenizer \
    php${VERSION}-xmlreader \
    php${VERSION}-xmlwriter \
    php${VERSION}-zip \
    php${VERSION}-zlib \
    php${VERSION}-phar \
    php${VERSION}-iconv \
    php${VERSION}-posix \
    php${VERSION}-pecl-redis \
    php${VERSION}-xdebug \
    && ln -sf /usr/bin/php${VERSION} /usr/bin/php \
    && ln -sf /usr/sbin/php${VERSION}-fpm /usr/sbin/php-fpm \
    && ln -sf /etc/php${VERSION} /etc/php \
    && test -L /usr/sbin/php-fpm && test -f /usr/sbin/php${VERSION}-fpm || (echo "ERROR: php-fpm symlink creation failed" && exit 1) \
    && rm -rf /var/cache/apk/* \
    && sed -i 's/bin\/ash/bin\/bash/g' /etc/passwd \
    && update-ca-certificates \
    && addgroup -g ${GUID} sail || echo "Group sail already exists" \
    && adduser -u ${GUID} -D -h /var/www -s /bin/bash -G sail sail || echo "User sail already exists" \
    && addgroup -g ${GUID} www-data || echo "Group www-data already exists" \
    && addgroup sail www-data || echo "User sail already in www-data group" \
    && rm -rf /var/www/* \
    && mkdir -p /var/log/nginx /var/log/php-fpm /var/log/php \
    && chown -R sail:sail /var \
    && chown -R sail:sail /var/www \
    && chmod -R 755 /var \
    && rm -rf /usr/local/etc/php-fpm.d/docker.conf

# Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Copy Sail files
COPY --from=runtime php.ini /etc/php/conf.d/99-sail.ini
COPY --from=runtime nginx.conf /etc/nginx/http.d/default.conf
COPY --from=runtime php-fpm.conf /etc/php/php-fpm.d/docker.conf

# S6
COPY --from=runtime ./s6/app /etc/s6-overlay/s6-rc.d/
RUN ln -s /etc/s6-overlay/s6-rc.d/logger/ /etc/s6-overlay/s6-rc.d/user/contents.d/logger

