stages:
  - build

variables:
  PHP_VERSION: "8.4"
  REGISTRY: {{REPOSITORY}}
  ORGANIZATION: {{ORGANIZATION}}
  APP_NAME: {{APP_NAME}}
  DOCKER_DRIVER: overlay2
  DOCKER_TLS_CERTDIR: "/certs"

build:
  stage: build
  image: docker:24.0.0
  services:
    - docker:24.0.0-dind
  before_script:
    - apk add --no-cache php php-json php-phar php-mbstring php-xml php-curl php-zip composer
    - |
      if [ -n "$AWS_ACCESS_KEY_ID" ] && [ -n "$AWS_SECRET_ACCESS_KEY" ]; then
        apk add --no-cache aws-cli
        aws configure set aws_access_key_id "$AWS_ACCESS_KEY_ID"
        aws configure set aws_secret_access_key "$AWS_SECRET_ACCESS_KEY"
        aws configure set default.region "${AWS_REGION:-us-east-1}"
      fi
    - |
      if [ -n "$AZURE_CLIENT_ID" ] && [ -n "$AZURE_CLIENT_SECRET" ]; then
        apk add --no-cache azure-cli
        az login --service-principal -u "$AZURE_CLIENT_ID" -p "$AZURE_CLIENT_SECRET" --tenant "$AZURE_TENANT_ID" || true
      fi
    - |
      if [ -n "$CI_REGISTRY_USER" ] && [ -n "$CI_REGISTRY_PASSWORD" ]; then
        echo "$CI_REGISTRY_PASSWORD" | docker login "$CI_REGISTRY" -u "$CI_REGISTRY_USER" --password-stdin
      elif [ -n "$REGISTRY_USERNAME" ] && [ -n "$REGISTRY_PASSWORD" ]; then
        echo "$REGISTRY_PASSWORD" | docker login "$REGISTRY" -u "$REGISTRY_USERNAME" --password-stdin
      fi
  script:
    - |
      if [ -n "$CI_COMMIT_TAG" ]; then
        VERSION=${CI_COMMIT_TAG#v}
      else
        VERSION=$(date +'%Y.%m.%d')-${CI_COMMIT_SHORT_SHA}
      fi
    - composer install --no-interaction --prefer-dist --optimize-autoloader --no-dev
    - |
      php artisan sail:build \
        --environments=production \
        --architectures=linux/amd64,linux/arm64 \
        --repository=$REGISTRY \
        --organization=$ORGANIZATION \
        --build-version=$VERSION \
        --push \
        --use-previous \
        --bump=no
  only:
    - main
    - master
    - tags
  tags:
    - docker

