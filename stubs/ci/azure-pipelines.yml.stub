trigger:
  branches:
    include:
      - main
      - master
  tags:
    include:
      - v*

pool:
  vmImage: 'ubuntu-latest'

variables:
  phpVersion: '8.4'
  registry: '{{REPOSITORY}}'
  organization: '{{ORGANIZATION}}'
  appName: '{{APP_NAME}}'

stages:
- stage: Build
  displayName: 'Build Docker Images'
  jobs:
  - job: BuildImages
    displayName: 'Build and Push Images'
    steps:
    - task: UsePHPVersion@0
      inputs:
        versionSpec: '$(phpVersion)'

    - task: Composer@0
      displayName: 'Install Composer Dependencies'
      inputs:
        workingDir: '$(System.DefaultWorkingDirectory)'
        composerPhpVersion: '$(phpVersion)'

    - task: Docker@2
      displayName: 'Set up Docker Buildx'
      inputs:
        command: 'setup'
        buildxVersion: 'latest'

    - task: Docker@2
      displayName: 'Login to Container Registry'
      condition: and(succeeded(), ne(variables['registry'], 'ecr'), not(contains(variables['registry'], 'amazonaws.com')), not(contains(variables['registry'], 'azurecr.io')))
      inputs:
        command: 'login'
        containerRegistry: 'DockerRegistryServiceConnection'
        # Or use: registry: '$(registry)'
        #          username: '$(REGISTRY_USERNAME)'
        #          password: '$(REGISTRY_PASSWORD)'

    - task: AWSShellScript@1
      displayName: 'Configure AWS for ECR'
      condition: and(succeeded(), or(contains(variables['registry'], 'ecr'), contains(variables['registry'], 'amazonaws.com')))
      inputs:
        awsCredentials: 'AWSConnection'
        regionName: '$(AWS_REGION)'
        scriptType: 'inline'
        inlineScript: |
          aws ecr get-login-password --region $(AWS_REGION) | docker login --username AWS --password-stdin $(registry)

    - task: AzureCLI@2
      displayName: 'Login to Azure Container Registry'
      condition: and(succeeded(), contains(variables['registry'], 'azurecr.io'))
      inputs:
        azureSubscription: 'AzureServiceConnection'
        scriptType: 'bash'
        scriptLocation: 'inlineScript'
        inlineScript: |
          az acr login --name $(ACR_NAME)

    - task: Bash@3
      displayName: 'Extract Version'
      inputs:
        targetType: 'inline'
        script: |
          if [ -n "$(Build.SourceTag)" ]; then
            VERSION=${Build.SourceTag#v}
          else
            VERSION=$(date +'%Y.%m.%d')-$(echo $(Build.SourceVersion) | cut -c1-8)
          fi
          echo "##vso[task.setvariable variable=VERSION]$VERSION"

    - task: Bash@3
      displayName: 'Build Docker Images and Helm Chart'
      inputs:
        targetType: 'inline'
        script: |
          php artisan sail:build \
            --environments=production \
            --architectures=linux/amd64,linux/arm64 \
            --repository=$(registry) \
            --organization=$(organization) \
            --build-version=$(VERSION) \
            --push \
            --use-previous \
            --bump=no

