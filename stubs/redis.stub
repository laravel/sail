redis:
    image: 'redis:alpine'
    restart: unless-stopped
    ports:
        - '${SAIL_IP:-172.20.0.10}:${FORWARD_REDIS_PORT:-6379}:6379'
    volumes:
        - 'sail-redis:/data'
    networks:
        - sail
    healthcheck:
        test: ["CMD", "redis-cli", "ping"]
        retries: 3
        timeout: 5s
