apiVersion: v1
kind: Secret
metadata:
  name: {{ include "sail.name" . }}-defaults
  labels:
    {{- include "sail.labels" . | nindent 4 }}
type: Opaque
stringData:
  {{- $app := .Values.app | default dict }}
  LOG_CHANNEL: {{ $app.logChannel | default "stderr" | quote }}
  {{- if .Values.redis.secret }}
  CACHE_DRIVER: {{ $app.cacheDriver | default "redis" | quote }}
  SESSION_DRIVER: {{ $app.sessionDriver | default "redis" | quote }}
  {{- end }}
