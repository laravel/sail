{{ define "sail.laravelSpec" }}
{{ if .enabled }}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ include "sail.name" . }}-{{ .tier }}
  labels:
    {{- include "sail.labels" . | nindent 4 }}
    tier: {{ .tier }}
  {{- with .main.annotations }}
  annotations:
    {{- toYaml . | nindent 4 }}
  {{- end }}
spec:
  replicas: {{ .replicaCount | default .main.global.replicaCount | default 1 }}
  selector:
    matchLabels:
      {{- include "sail.selectorLabels" . | nindent 6 }}
      tier: {{ .tier }}
  template:
    metadata:
      labels:
        {{- include "sail.labels" . | nindent 8 }}
        tier: {{ .tier }}
      {{- with .main.podAnnotations }}
      annotations:
        {{- toYaml . | nindent 8 }}
      {{- end }}
    spec:
      {{- if .main.serviceAccountName }}
      serviceAccountName: {{ .main.serviceAccountName }}
      {{- end }}
      {{- if .securityContext }}
      securityContext:
        {{- toYaml .securityContext | nindent 8 }}
      {{- end }}
      {{- if or .imagePullSecret .main.global.imagePullSecret }}
      imagePullSecrets:
        - name: {{ .imagePullSecret | default .main.global.imagePullSecret }}
      {{- end }}
      {{- with .main.affinity }}
      affinity:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- with .main.tolerations }}
      tolerations:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- with .main.nodeSelector }}
      nodeSelector:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      containers:
        - name: {{ .tier }}
          image: {{ .image.repository | default "ghcr.io/example/app" | lower }}:{{ .image.tag | default .main.global.tag | default "latest" | lower }}
          imagePullPolicy: {{ .image.pullPolicy | default .main.global.pullPolicy | default "IfNotPresent" }}
          {{- with .resources }}
          resources:
            {{- toYaml . | nindent 12 }}
          {{- end }}
          {{- if eq .tier "web" }}
          ports:
            - containerPort: 80
          {{- end }}
          {{- $tierProbes := .probes | default dict }}
          {{- $globalProbes := .main.global.probes | default dict }}
          {{- $readinessProbe := merge ($globalProbes.readinessProbe | default dict) ($tierProbes.readinessProbe | default dict) }}
          {{- $livenessProbe := merge ($globalProbes.livenessProbe | default dict) ($tierProbes.livenessProbe | default dict) }}
          {{- $startupProbe := merge ($globalProbes.startupProbe | default dict) ($tierProbes.startupProbe | default dict) }}
          {{- $hasReadinessConfig := or $readinessProbe.httpGet $readinessProbe.exec $readinessProbe.tcpSocket }}
          {{- $readinessEnabled := and $hasReadinessConfig (or (not (hasKey $readinessProbe "enabled")) $readinessProbe.enabled) }}
          {{- if $readinessEnabled }}
          readinessProbe:
            {{- if $readinessProbe.httpGet }}
            httpGet:
              {{- toYaml $readinessProbe.httpGet | nindent 14 }}
            {{- else if $readinessProbe.exec }}
            exec:
              {{- toYaml $readinessProbe.exec | nindent 14 }}
            {{- else if $readinessProbe.tcpSocket }}
            tcpSocket:
              {{- toYaml $readinessProbe.tcpSocket | nindent 14 }}
            {{- end }}
            {{- if $readinessProbe.initialDelaySeconds }}
            initialDelaySeconds: {{ $readinessProbe.initialDelaySeconds }}
            {{- end }}
            {{- if $readinessProbe.periodSeconds }}
            periodSeconds: {{ $readinessProbe.periodSeconds }}
            {{- end }}
            {{- if $readinessProbe.timeoutSeconds }}
            timeoutSeconds: {{ $readinessProbe.timeoutSeconds }}
            {{- end }}
            {{- if $readinessProbe.successThreshold }}
            successThreshold: {{ $readinessProbe.successThreshold }}
            {{- end }}
            {{- if $readinessProbe.failureThreshold }}
            failureThreshold: {{ $readinessProbe.failureThreshold }}
            {{- end }}
          {{- end }}
          {{- $hasLivenessConfig := or $livenessProbe.httpGet $livenessProbe.exec $livenessProbe.tcpSocket }}
          {{- $livenessEnabled := and $hasLivenessConfig (or (not (hasKey $livenessProbe "enabled")) $livenessProbe.enabled) }}
          {{- if $livenessEnabled }}
          livenessProbe:
            {{- if $livenessProbe.httpGet }}
            httpGet:
              {{- toYaml $livenessProbe.httpGet | nindent 14 }}
            {{- else if $livenessProbe.exec }}
            exec:
              {{- toYaml $livenessProbe.exec | nindent 14 }}
            {{- else if $livenessProbe.tcpSocket }}
            tcpSocket:
              {{- toYaml $livenessProbe.tcpSocket | nindent 14 }}
            {{- end }}
            {{- if $livenessProbe.initialDelaySeconds }}
            initialDelaySeconds: {{ $livenessProbe.initialDelaySeconds }}
            {{- end }}
            {{- if $livenessProbe.periodSeconds }}
            periodSeconds: {{ $livenessProbe.periodSeconds }}
            {{- end }}
            {{- if $livenessProbe.timeoutSeconds }}
            timeoutSeconds: {{ $livenessProbe.timeoutSeconds }}
            {{- end }}
            {{- if $livenessProbe.successThreshold }}
            successThreshold: {{ $livenessProbe.successThreshold }}
            {{- end }}
            {{- if $livenessProbe.failureThreshold }}
            failureThreshold: {{ $livenessProbe.failureThreshold }}
            {{- end }}
          {{- end }}
          {{- $hasStartupConfig := or $startupProbe.httpGet $startupProbe.exec $startupProbe.tcpSocket }}
          {{- $startupEnabled := and $hasStartupConfig (hasKey $startupProbe "enabled") $startupProbe.enabled }}
          {{- if $startupEnabled }}
          startupProbe:
            {{- if $startupProbe.httpGet }}
            httpGet:
              {{- toYaml $startupProbe.httpGet | nindent 14 }}
            {{- else if $startupProbe.exec }}
            exec:
              {{- toYaml $startupProbe.exec | nindent 14 }}
            {{- else if $startupProbe.tcpSocket }}
            tcpSocket:
              {{- toYaml $startupProbe.tcpSocket | nindent 14 }}
            {{- end }}
            {{- if $startupProbe.initialDelaySeconds }}
            initialDelaySeconds: {{ $startupProbe.initialDelaySeconds }}
            {{- end }}
            {{- if $startupProbe.periodSeconds }}
            periodSeconds: {{ $startupProbe.periodSeconds }}
            {{- end }}
            {{- if $startupProbe.timeoutSeconds }}
            timeoutSeconds: {{ $startupProbe.timeoutSeconds }}
            {{- end }}
            {{- if $startupProbe.successThreshold }}
            successThreshold: {{ $startupProbe.successThreshold }}
            {{- end }}
            {{- if $startupProbe.failureThreshold }}
            failureThreshold: {{ $startupProbe.failureThreshold }}
            {{- end }}
          {{- end }}
          {{ if eq .tier "worker" }}
            {{ if .horizon }}
          command: ["/usr/local/bin/run-horizon"]
            {{ else }}
          command: ["php", "artisan", "queue:work", "--verbose", "--tries=3", "--no-interaction"]
            {{ end }}
          {{ end }}
          {{- $hasInfraSecrets := or .main.database.secret .main.redis.secret .main.s3.secret }}
          {{- if $hasInfraSecrets }}
          env:
            {{- if .main.database.secret }}
            - name: DB_CONNECTION
              value: {{ .main.database.connection | default "mysql" }}
            - name: DB_HOST
              valueFrom:
                secretKeyRef:
                  name: {{ .main.database.secret }}
                  key: host
            - name: DB_PORT
              valueFrom:
                secretKeyRef:
                  name: {{ .main.database.secret }}
                  key: port
            - name: DB_DATABASE
              valueFrom:
                secretKeyRef:
                  name: {{ .main.database.secret }}
                  key: database
            - name: DB_USERNAME
              valueFrom:
                secretKeyRef:
                  name: {{ .main.database.secret }}
                  key: username
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ .main.database.secret }}
                  key: password
            {{- end }}
            {{- if .main.redis.secret }}
            - name: REDIS_HOST
              valueFrom:
                secretKeyRef:
                  name: {{ .main.redis.secret }}
                  key: host
            - name: REDIS_PORT
              valueFrom:
                secretKeyRef:
                  name: {{ .main.redis.secret }}
                  key: port
            - name: REDIS_CLIENT
              value: phpredis
            - name: REDIS_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ .main.redis.secret }}
                  key: password
            - name: REDIS_SENTINEL_HOST
              valueFrom:
                secretKeyRef:
                  name: {{ .main.redis.secret }}
                  key: sentinel_host
            - name: REDIS_SENTINEL_PORT
              valueFrom:
                secretKeyRef:
                  name: {{ .main.redis.secret }}
                  key: sentinel_port
            - name: REDIS_SENTINEL_SERVICE
              valueFrom:
                secretKeyRef:
                  name: {{ .main.redis.secret }}
                  key: sentinel_service
            {{- end }}
            {{- if .main.s3.secret }}
            - name: AWS_ACCESS_KEY_ID
              valueFrom:
                secretKeyRef:
                  name: {{ .main.s3.secret }}
                  key: accessKeyId
            - name: AWS_SECRET_ACCESS_KEY
              valueFrom:
                secretKeyRef:
                  name: {{ .main.s3.secret }}
                  key: secretAccessKey
            - name: AWS_BUCKET
              valueFrom:
                secretKeyRef:
                  name: {{ .main.s3.secret }}
                  key: bucket
            - name: AWS_ENDPOINT
              valueFrom:
                secretKeyRef:
                  name: {{ .main.s3.secret }}
                  key: endpoint
            - name: AWS_DEFAULT_REGION
              value: {{ .main.s3.region | default "us-east-1" }}
            - name: AWS_USE_PATH_STYLE_ENDPOINT
              value: {{ .main.s3.pathStyle | default "true" | quote }}
            - name: FILESYSTEM_DISK
              value: s3
            {{- if .main.s3.url }}
            - name: AWS_URL
              value: {{ .main.s3.url }}
            {{- end }}
            {{- end }}
          {{- end }}
          envFrom:
            - secretRef:
                name: {{ include "sail.name" . }}-environment
            {{- if .main.typesense.enabled }}
            - secretRef:
                name: {{ .main.typesense.secret | default (printf "%s-typesense" (include "sail.name" .)) }}
            {{- end }}
        {{- if .main.global.nightwatch }}
        {{- if .main.global.nightwatch.enabled }}
        - name: nightwatch-agent
          image: {{ .main.global.nightwatch.image | default "laravelphp/nightwatch-agent:v1" }}
          ports:
            - containerPort: 2407
              protocol: TCP
          env:
            - name: NIGHTWATCH_TOKEN
              valueFrom:
                secretKeyRef:
                  name: {{ include "sail.name" . }}-environment
                  key: NIGHTWATCH_TOKEN
          livenessProbe:
            tcpSocket:
              port: 2407
            initialDelaySeconds: 5
            periodSeconds: 30
          {{- with .main.global.nightwatch.resources }}
          resources:
            {{- toYaml . | nindent 12 }}
          {{- end }}
        {{- end }}
        {{- end }}
{{ end }}
{{ end }}