{{ define "sail.laravelSpec" }}
{{ if .enabled }}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ include "sail.name" . }}-{{ .tier }}
  labels:
    {{- include "sail.labels" . | nindent 4 }}
    tier: {{ .tier }}
  {{- with .main.annotations }}
  annotations:
    {{- toYaml . | nindent 4 }}
  {{- end }}
spec:
  replicas: {{ .replicaCount | default .main.global.replicaCount | default 1 }}
  selector:
    matchLabels:
      {{- include "sail.selectorLabels" . | nindent 6 }}
      tier: {{ .tier }}
  template:
    metadata:
      labels:
        {{- include "sail.selectorLabels" . | nindent 8 }}
        tier: {{ .tier }}
      {{- with .main.podAnnotations }}
      annotations:
        {{- toYaml . | nindent 8 }}
      {{- end }}
    spec:
      {{- if .main.serviceAccountName }}
      serviceAccountName: {{ .main.serviceAccountName }}
      {{- end }}
      {{- if .securityContext }}
      securityContext:
        {{- toYaml .securityContext | nindent 8 }}
      {{- end }}
      {{- if or .imagePullSecret .main.global.imagePullSecret }}
      imagePullSecrets:
        - name: {{ .imagePullSecret | default .main.global.imagePullSecret }}
      {{- end }}
      {{- with .main.affinity }}
      affinity:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- with .main.tolerations }}
      tolerations:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- with .main.nodeSelector }}
      nodeSelector:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      containers:
        - name: {{ .tier }}
          image: {{ .image.repository | default "ghcr.io/example/app" | lower }}:{{ .image.tag | default .main.global.tag | default "latest" | lower }}
          imagePullPolicy: {{ .image.pullPolicy | default .main.global.pullPolicy | default "IfNotPresent" }}
          {{- with .resources }}
          resources:
            {{- toYaml . | nindent 12 }}
          {{- end }}
          {{ if eq .tier "web" }}
          ports:
            - containerPort: 80
          readinessProbe:
            httpGet:
              path: /up
              port: 80
            initialDelaySeconds: 10
            periodSeconds: 20
            failureThreshold: 5
          livenessProbe:
            httpGet:
              path: /up
              port: 80
            initialDelaySeconds: 10
            periodSeconds: 30
            failureThreshold: 3
          {{ end }}
          {{ if eq .tier "worker" }}
            {{ if .horizon }}
          command: ["/usr/local/bin/run-horizon"]
            {{ else }}
          command: ["php", "artisan", "queue:work", "--verbose", "--tries=3", "--no-interaction"]
            {{ end }}
          {{ end }}
          envFrom:
            - secretRef:
                name: {{ include "sail.name" . }}-environment
            {{- if .main.typesense.enabled }}
            - secretRef:
                name: {{ .main.typesense.secret | default "typesense" | lower }}
            {{- end }}
{{ end }}
{{ end }}