apiVersion: v1
kind: Service
metadata:
  name: {{ include "sail.name" . }}
  labels:
    {{- include "sail.labels" . | nindent 4 }}
    tier: web
  {{- with .Values.service.annotations }}
  annotations:
    {{- toYaml . | nindent 4 }}
  {{- end }}
spec:
  type: {{ .Values.service.type }}
  ports:
    - port: {{ .Values.service.port }}
      targetPort: 80
      protocol: TCP
      name: http
  selector:
    {{- include "sail.selectorLabels" . | nindent 4 }}
    tier: web