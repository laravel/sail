

{{- if .Values.secret.enabled -}}
apiVersion: {{ include "sail.externalSecret.apiVersion" . }}
kind: ExternalSecret
metadata:
  name: {{ .Values.name | default "website" | lower }}
  namespace: {{ .Release.Namespace }}
spec:
  refreshInterval: 1m
  secretStoreRef:
    name: {{ .Values.secret.store }}
    kind: ClusterSecretStore
  target:
    name: {{ .Values.name | default "website" | lower }}-environment
    creationPolicy: Owner
  dataFrom:
    - extract:
        key: {{ .Values.secret.path }}
{{- end }}