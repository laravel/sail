# ------------------------------------------------------------------------------
# Sail Helm Chart Values - Configuration Reference
# This file defines default values for customizing the Sail Laravel deployment.
# ------------------------------------------------------------------------------

# Global defaults applied to all components (web, worker, etc.)
global:
  # replicaCount: 2
  tag: latest
  pullPolicy: IfNotPresent
  imagePullSecret: ghcr-auth

# Web application deployment settings
web:
  enabled: true
  replicaCount: 2
  image:
    repository: ghcr.io/<organization>/<package>
    # tag: latest
    # pullPolicy: IfNotPresent
    # imagePullSecret: ghcr-auth

# Queue worker deployment settings
worker:
  enabled: true
  horizon: true
  replicaCount: 1
  image:
    repository: ghcr.io/<organization>/<package>
    # tag: latest
    # pullPolicy: IfNotPresent
    # imagePullSecret: ghcr-auth

# Laravel scheduler configuration
scheduler:
  enabled: true
  schedule: "*/5 * * * *"
  successfulJobsHistoryLimit: 5
  failedJobsHistoryLimit: 5
  vendorPvc:
    enabled: true
    accessModes:
      - ReadWriteOnce
    size: 5Gi
    storageClassName: "sata"

# Base name used for resources (e.g., service, ingress)
name: <project-name>

# External secrets configuration (e.g., from Vault)
secret:
  enabled: true
  path: <path-to-secret>
  store: <secret-store-name>

# Service definition for exposing the Laravel web container
service:
  type: ClusterIP
  port: 80
  # annotations: {}  # Annotations to add to the service

# Kubernetes resource requests/limits (CPU/memory)
resources:
  requests:
    cpu: 100m
    memory: 256Mi
  limits:
    cpu: 500m
    memory: 512Mi

# Pod/container security context defaults
securityContext:
  runAsNonRoot: true
  runAsUser: 1000
  fsGroup: 1000
  allowPrivilegeEscalation: false

# ServiceAccount configuration
serviceAccount:
  # Specifies whether a service account should be created
  create: true
  # Annotations to add to the service account
  annotations: {}
  # The name of the service account to use.
  # If not set and create is true, a name is generated using the fullname template
  name: ""

# Pod Disruption Budget configuration
podDisruptionBudget:
  enabled: false
  # minAvailable: 1  # Minimum number of pods that must be available
  maxUnavailable: 1  # Maximum number of pods that can be unavailable

# Pod scheduling configuration
# Affinity rules for pod placement
# affinity: {}
# Example:
#   podAntiAffinity:
#     preferredDuringSchedulingIgnoredDuringExecution:
#       - weight: 100
#         podAffinityTerm:
#           labelSelector:
#             matchExpressions:
#               - key: app
#                 operator: In
#                 values:
#                   - {{ .Values.name }}
#           topologyKey: kubernetes.io/hostname

# Node selector for pod placement
# nodeSelector: {}

# Tolerations for pod scheduling
# tolerations: []

# Annotations to add to deployments
# annotations: {}

# Annotations to add to pods
# podAnnotations: {}

# Typesense
typesense:
  enabled: false

# Ingress settings (e.g., for Traefik or NGINX)
ingress:
  enabled: true
  className: "traefik"
  annotations:
    "kubernetes.io/ingress.class": "traefik"
    "traefik.ingress.kubernetes.io/router.entrypoints": "websecure"
    "traefik.ingress.kubernetes.io/router.tls.certresolver": "myresolver"
  hosts:
    - host: <host>
      paths:
        - path: /  # Path-based routing (e.g., / routes to the Laravel app)
          pathType: ImplementationSpecific
  tls: []