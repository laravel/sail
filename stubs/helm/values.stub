# ------------------------------------------------------------------------------
# Sail Helm Chart Values - Configuration Reference
# This file defines default values for customizing the Sail Laravel deployment.
# ------------------------------------------------------------------------------

# Global defaults applied to all components (web, worker, etc.)
global:
  # replicaCount: 2
  tag: latest
  pullPolicy: IfNotPresent
  imagePullSecret: ghcr-auth
  # Laravel Nightwatch agent sidecar (https://nightwatch.laravel.com)
  # Runs alongside each pod to collect telemetry on 127.0.0.1:2407
  nightwatch:
    enabled: false
    image: laravelphp/nightwatch-agent:v1
    resources:
      requests:
        cpu: 10m
        memory: 32Mi
      limits:
        cpu: 50m
        memory: 64Mi
  # Global probe defaults (can be overridden per tier)
  probes:
    # readinessProbe:
    #   enabled: true
    #   httpGet:
    #     path: /up
    #     port: 80
    #     scheme: HTTP
    #   initialDelaySeconds: 10
    #   periodSeconds: 20
    #   timeoutSeconds: 5
    #   successThreshold: 1
    #   failureThreshold: 5
    # livenessProbe:
    #   enabled: true
    #   httpGet:
    #     path: /up
    #     port: 80
    #     scheme: HTTP
    #   initialDelaySeconds: 10
    #   periodSeconds: 30
    #   timeoutSeconds: 5
    #   successThreshold: 1
    #   failureThreshold: 3
    # startupProbe:
    #   enabled: false
    #   httpGet:
    #     path: /up
    #     port: 80
    #     scheme: HTTP
    #   initialDelaySeconds: 0
    #   periodSeconds: 10
    #   timeoutSeconds: 5
    #   successThreshold: 1
    #   failureThreshold: 30

# Web application deployment settings
web:
  enabled: true
  replicaCount: 2
  image:
    repository: ghcr.io/<organization>/<package>
    # tag: latest
    # pullPolicy: IfNotPresent
    # imagePullSecret: ghcr-auth
  # Health check probes for web tier (overrides global defaults)
  probes:
    readinessProbe:
      enabled: true
      httpGet:
        path: /up
        port: 80
        scheme: HTTP
      initialDelaySeconds: 10
      periodSeconds: 20
      timeoutSeconds: 5
      successThreshold: 1
      failureThreshold: 5
    livenessProbe:
      enabled: true
      httpGet:
        path: /up
        port: 80
        scheme: HTTP
      initialDelaySeconds: 10
      periodSeconds: 30
      timeoutSeconds: 5
      successThreshold: 1
      failureThreshold: 8  # 30s * 8 = 240s = 4 minutes minimum before restart
    # startupProbe:
    #   enabled: false
    #   httpGet:
    #     path: /up
    #     port: 80
    #     scheme: HTTP
    #   initialDelaySeconds: 0
    #   periodSeconds: 10
    #   timeoutSeconds: 5
    #   successThreshold: 1
    #   failureThreshold: 30
  # Horizontal Pod Autoscaler configuration (enabled by default for web tier)
  autoscaling:
    enabled: true
    minReplicas: 2
    maxReplicas: 10
    targetCPUUtilizationPercentage: 70
    # targetMemoryUtilizationPercentage: 80
    # Advanced scaling behavior (Kubernetes 1.18+)
    # behavior:
    #   scaleDown:
    #     stabilizationWindowSeconds: 300
    #     policies:
    #       - type: Percent
    #         value: 50
    #         periodSeconds: 60
    #   scaleUp:
    #     stabilizationWindowSeconds: 0
    #     policies:
    #       - type: Percent
    #         value: 100
    #         periodSeconds: 15

# Queue worker deployment settings
worker:
  enabled: true
  horizon: true
  replicaCount: 1
  image:
    repository: ghcr.io/<organization>/<package>
    # tag: latest
    # pullPolicy: IfNotPresent
    # imagePullSecret: ghcr-auth
  # Health check probes for worker tier (overrides global defaults)
  # Workers typically use exec probes to check queue status
  probes:
    readinessProbe:
      enabled: true
      exec:
        command:
          - php
          - artisan
          - horizon:status
      initialDelaySeconds: 30  # Workers take longer to start
      periodSeconds: 30
      timeoutSeconds: 10
      successThreshold: 1
      failureThreshold: 3
    livenessProbe:
      enabled: true
      exec:
        command:
          - php
          - artisan
          - horizon:status
      initialDelaySeconds: 60  # Give workers more time before checking liveness
      periodSeconds: 60        # Less frequent than readiness
      timeoutSeconds: 10
      successThreshold: 1
      failureThreshold: 4
    # startupProbe:
    #   enabled: false
    #   exec:
    #     command:
    #       - php
    #       - artisan
    #       - horizon:status
    #   initialDelaySeconds: 0
    #   periodSeconds: 10
    #   timeoutSeconds: 10
    #   successThreshold: 1
    #   failureThreshold: 30
  # Horizontal Pod Autoscaler configuration
  # autoscaling:
  #   enabled: false
  #   minReplicas: 1
  #   maxReplicas: 5
  #   targetCPUUtilizationPercentage: 70
  #   targetMemoryUtilizationPercentage: 80

# Laravel scheduler configuration
scheduler:
  enabled: true
  schedule: "*/5 * * * *"
  successfulJobsHistoryLimit: 5
  failedJobsHistoryLimit: 5
  vendorPvc:
    enabled: false
    accessModes:
      - ReadWriteOnce
    size: 5Gi
    storageClassName: "sata"

# Pre-deploy image verification
imageCheck:
  enabled: true

# Pre-deploy database migrations
migrations:
  enabled: true
  activeDeadlineSeconds: 300

# Base name used for resources (e.g., service, ingress)
name: <project-name>

# External secrets configuration (e.g., from Vault)
secret:
  enabled: true
  path: <path-to-secret>
  store: <secret-store-name>

# Service definition for exposing the Laravel web container
service:
  type: ClusterIP
  port: 80
  # annotations: {}  # Annotations to add to the service

# Suggested Kubernetes resource requests/limits applied to all deployment
# tiers unless overridden per-tier (e.g. web.resources or worker.resources).
# These values are the recommended starting point for a Laravel web/worker
# pod; override per consumer as needed.
#
# If this block is set to null or omitted entirely, the sail.resources
# helper falls back to hardcoded defaults (requests 100m/256Mi, limits
# 1000m/1Gi), which are intentionally more generous than the suggested
# values below to tolerate unoptimized workloads.
resources:
  requests:
    cpu: 100m
    memory: 256Mi
  limits:
    cpu: 500m
    memory: 512Mi

# Pod/container security context defaults
securityContext:
  runAsNonRoot: true
  runAsUser: 1000
  fsGroup: 1000
  allowPrivilegeEscalation: false

# ServiceAccount configuration
serviceAccount:
  # Specifies whether a service account should be created
  create: true
  # Annotations to add to the service account
  annotations: {}
  # The name of the service account to use.
  # If not set and create is true, a name is generated using the fullname template
  name: ""

# Pod Disruption Budget configuration
# PDB works with HPA (Horizontal Pod Autoscaler) - use percentage-based values for autoscaling compatibility
podDisruptionBudget:
  enabled: false
  # minAvailable: 1  # Minimum number of pods that must be available (can be number or percentage like "50%")
  # maxUnavailable: 1  # Maximum number of pods that can be unavailable (can be number or percentage)
  maxUnavailablePercent: "50%"  # Percentage-based (recommended for autoscaling) - allows HPA to scale down smoothly

# Pod scheduling configuration
# Affinity rules for pod placement
# affinity: {}
# Example:
#   podAntiAffinity:
#     preferredDuringSchedulingIgnoredDuringExecution:
#       - weight: 100
#         podAffinityTerm:
#           labelSelector:
#             matchExpressions:
#               - key: app
#                 operator: In
#                 values:
#                   - {{ .Values.name }}
#           topologyKey: kubernetes.io/hostname

# Node selector for pod placement
# nodeSelector: {}

# Tolerations for pod scheduling
# tolerations: []

# Annotations to add to deployments
# annotations: {}

# Annotations to add to pods
# podAnnotations: {}

# Infrastructure secrets (nimbus-replicated secrets → Laravel env vars)
# When set, env vars from these secrets take precedence over envFrom (Vault)
database:
    secret: ""            # nimbus MariaDB/PG replicated secret (host, port, username, password, database, uri)
    connection: mysql     # DB_CONNECTION value
redis:
    secret: ""            # nimbus Redis replicated secret (host, port, password, uri)
s3:
    secret: ""            # nimbus MinIO replicated secret (accessKeyId, secretAccessKey, bucket, endpoint)
    region: us-east-1     # AWS_DEFAULT_REGION
    pathStyle: "true"     # AWS_USE_PATH_STYLE_ENDPOINT

# Laravel application behavior defaults. These become a chart-owned
# Secret (<name>-defaults) prepended to envFrom; the consumer's
# <name>-environment secret takes precedence (envFrom later-entry-wins).
app:
  # LOG_CHANNEL default - stderr flows logs through php-fpm stderr to
  # the s6-log pipeline (stdout + rotated file per sail.logging.mode).
  logChannel: stderr
  # CACHE_DRIVER / SESSION_DRIVER are only written to the defaults
  # secret when redis.secret is set. Unset (file default) otherwise.
  cacheDriver: redis
  sessionDriver: redis

# Logging pipeline behavior (web tier nginx/php-fpm logs).
# Worker/scheduler pods bypass s6 entirely; their logs always go to stdout.
logging:
  # stdout - logs only to container stdout, kubelet rotates (~12Mi/pod).
  # file   - logs only to /var/log/{nginx,php-fpm}/ rotated by s6-log.
  # both   - logs to rotated files AND stdout tee (default).
  mode: both
  # s6-log -n argument: number of rotated archives retained per service.
  maxArchives: 20
  # s6-log -s argument: bytes per file before rotation. Raw integer (no suffix,
  # no K/M/G). Large values are safe; the chart prevents Helm's default
  # scientific-notation coercion.
  maxFileSize: 10000000

# Typesense search (deploys Typesense when enabled)
typesense:
    enabled: false
    image: typesense/typesense:28.0
    secret: ""            # defaults to {appname}-typesense
    apiKey: ""            # auto-generated if empty
    storageSize: 2Gi
    storageClassName: ""

# Ingress settings (e.g., for Traefik or NGINX)
ingress:
  enabled: true
  className: "traefik"
  annotations:
    "kubernetes.io/ingress.class": "traefik"
    "traefik.ingress.kubernetes.io/router.entrypoints": "websecure"
    "traefik.ingress.kubernetes.io/router.tls.certresolver": "myresolver"
  hosts:
    - host: <host>
      paths:
        - path: /  # Path-based routing (e.g., / routes to the Laravel app)
          pathType: ImplementationSpecific
  tls: []