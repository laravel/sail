# For more information: https://laravel.com/docs/sail
name: '${SAIL_PROJECT}'

services:
    laravel:
        build:
            context: ./vendor/reyemtech/sail/runtimes/8.x
            dockerfile: Dockerfile
            args:
                PHP_VERSION: '${PHP_VERSION}'
                WWWGROUP: '${WWWGROUP}'
        image: sail-{{PHP_VERSION}}/app
        extra_hosts:
            - 'host.docker.internal:host-gateway'
        expose:
            - 80
        ports:
            - '${SAIL_IP:-172.20.0.10}:${VITE_PORT:-5173}:${VITE_PORT:-5173}'
        environment:
            - SUPERVISOR_PHP_USER='sail'
            - WWWUSER='${WWWUSER}'
            - LARAVEL_SAIL=1
            - XDEBUG_MODE='${SAIL_XDEBUG_MODE:-off}'
            - XDEBUG_CONFIG='${SAIL_XDEBUG_CONFIG:-client_host=host.docker.internal}'
            - IGNITION_LOCAL_SITES_PATH='${PWD}'
            - VIRTUAL_HOST=${SAIL_DOMAIN}
            - VIRTUAL_PORT=80
            - APP_ENV='sail'
        volumes:
            - '.:/var/www'
            - logs:/var/log
        networks:
            - sail
    nginx-proxy:
        image: nginxproxy/nginx-proxy:alpine
        labels:
            - com.github.nginx-proxy.nginx-proxy
        ports:
            - "${SAIL_IP:-172.20.0.10}:80:80"
            - "${SAIL_IP:-172.20.0.10}:443:443"
        volumes:
            - /var/run/docker.sock:/tmp/docker.sock:ro
            - nginx_vhost:/etc/nginx/vhost.d
            - nginx_html:/usr/share/nginx/html
            - ./vendor/reyemtech/sail/certs:/etc/nginx/certs:ro,z
        networks:
            - sail
volumes:
  nginx_vhost:
  nginx_html:
  logs:

networks:
    sail:
        driver: bridge
        ipam:
            config:
                - subnet: ${SAIL_SUBNET:-172.20.0.0/24}
